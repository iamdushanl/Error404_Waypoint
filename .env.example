# ============================================================
# Waypoint — Environment Variables
# ============================================================

# Application
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# SERVICE ROLE KEY: server-side only — NEVER send to browser or mobile app
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# JWT secret for verifying Supabase auth tokens in FastAPI
# Get from: Supabase Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=<your-jwt-secret>

# ── Database ──────────────────────────────────────────────────────────────────
# Direct PostgreSQL connection string (for migrations/seed/sqlalchemy)
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the browser clients.
# Local development includes both web (5173) and mobile-web (3001).
# Add your deployed Vercel URL for production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ── Web frontend build args (Phase 9 Docker only) ─────────────────────────────
# These are forwarded as Docker build args and baked into the Vite JS bundle.
# They must match the Supabase values above — copy them here.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
# Inside Docker Compose the browser talks to localhost:8000 (mapped port).
VITE_API_BASE_URL=http://localhost:8000

# ── Seed runner control (Phase 9) ─────────────────────────────────────────────
# Set SEED_SKIP_CSV=1 if the competition CSV files are not available in data/.
# The seed script will still create demo users and sample orders.
SEED_SKIP_CSV=0
# Walkthrough date for sample orders. Leave blank to use seed.py default.
SEED_PLAN_DATE=
